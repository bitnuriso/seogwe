<body>
<header>
  <div class="row">
    <strong>PDF 다다다닥</strong>
    <span id="counter" class="meta">0 / 0</span>
  </div>

  <details open>
    <summary>암호 압축파일 풀기</summary>

    <div class="row" style="margin-top: 10px">
      <input
        id="archive"
