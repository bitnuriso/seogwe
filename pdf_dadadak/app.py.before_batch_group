      start: bestStart,
      end: bestEnd
    };
  }

  const verticalRange = findLongestRange(
    rowCounts,
    minimumRowPixels,
    step
  );

  const horizontalRange = findLongestRange(
    columnCounts,
    minimumColumnPixels,
    step
  );

  if (
    horizontalRange.start < 0 ||
    verticalRange.start < 0
  ) {
