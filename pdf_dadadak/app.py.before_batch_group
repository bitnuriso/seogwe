      const red = data[offset];
      const green = data[offset + 1];
      const blue = data[offset + 2];
      const alpha = data[offset + 3];

      if (alpha < 20) {
        continue;
      }

      const deltaR = red - backgroundR;
      const deltaG = green - backgroundG;
      const deltaB = blue - backgroundB;

      const colorDistance = Math.sqrt(
        deltaR * deltaR +
        deltaG * deltaG +
        deltaB * deltaB
      );

      if (colorDistance > colorThreshold) {
        rowCounts[y] += 1;
        columnCounts[x] += 1;
      }
    }
  }

  const sampledColumns = Math.ceil(width / step);
  const sampledRows = Math.ceil(height / step);

  const minimumRowPixels = Math.max(
    5,
    Math.floor(sampledColumns * 0.08)
  );

  const minimumColumnPixels = Math.max(
    5,
    Math.floor(sampledRows * 0.08)
