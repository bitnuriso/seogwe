  const { data, width, height } = image;

  function rgbAt(x, y) {
    const offset = (y * width + x) * 4;

    return {
      r: data[offset],
      g: data[offset + 1],
      b: data[offset + 2]
    };
  }

  const samplePoints = [
    [2, 2],
    [width - 3, 2],
    [2, height - 3],
    [width - 3, height - 3],
    [Math.floor(width * 0.25), 2],
    [Math.floor(width * 0.50), 2],
    [Math.floor(width * 0.75), 2],
    [Math.floor(width * 0.25), height - 3],
    [Math.floor(width * 0.50), height - 3],
    [Math.floor(width * 0.75), height - 3]
  ];

  let backgroundR = 0;
  let backgroundG = 0;
  let backgroundB = 0;

  for (const [sampleX, sampleY] of samplePoints) {
    const pixel = rgbAt(
      clamp(sampleX, 0, width - 1),
      clamp(sampleY, 0, height - 1)
    );

    backgroundR += pixel.r;
    backgroundG += pixel.g;
    backgroundB += pixel.b;
